From: beitlab Robotics MilkV duo OS <image/patches>
Subject: [PATCH 9/9] buildroot: allow piped passwords in wpa_passphrase 2.11

Local fix against SDK 6f8962c394dd0a05729abb089f0feb7d5cc4aa5e.
Install a package patch for the terminal-only input regression discovered
on hardware during serial Wi-Fi setup. Existing Buildroot output needs
wpa_supplicant-dirclean before rebuilding to apply this package patch.
---
--- /dev/null
+++ b/buildroot/package/wpa_supplicant/0003-wpa-passphrase-accept-piped-password.patch
@@ -0,0 +1,45 @@
+From: beitlab Robotics MilkV duo OS <image/patches>
+Subject: [PATCH] wpa_passphrase: accept passphrases on non-terminal stdin
+
+Local compatibility fix for wpa_supplicant 2.11 shipped by the pinned SDK.
+The Wi-Fi wizard already reads passwords with echo disabled and passes them
+through a pipe. Only change terminal echo when stdin is a terminal; retain
+stdin input so passwords never need to appear in process arguments.
+
+Upstream-Status: Pending
+---
+--- a/wpa_supplicant/wpa_passphrase.c
++++ b/wpa_supplicant/wpa_passphrase.c
+@@ -33,15 +33,18 @@
+ 	if (argc > 2) {
+ 		passphrase = argv[2];
+ 	} else {
+-		bool ctrl_echo;
++		bool ctrl_echo = false;
+ 
+ 		fprintf(stderr, "# reading passphrase from stdin\n");
+-		if (tcgetattr(STDIN_FILENO, &term) < 0) {
++		if (isatty(STDIN_FILENO) &&
++		    tcgetattr(STDIN_FILENO, &term) < 0) {
+ 			perror("tcgetattr");
+ 			return 1;
+ 		}
+-		ctrl_echo = term.c_lflag & ECHO;
+-		term.c_lflag &= ~ECHO;
++		if (isatty(STDIN_FILENO)) {
++			ctrl_echo = term.c_lflag & ECHO;
++			term.c_lflag &= ~ECHO;
++		}
+ 		if (ctrl_echo && tcsetattr(STDIN_FILENO, TCSANOW, &term) < 0) {
+ 			perror("tcsetattr:error disabling echo");
+ 			return 1;
+@@ -50,7 +53,8 @@
+ 			fprintf(stderr, "Failed to read passphrase\n");
+ 			return 1;
+ 		}
+-		term.c_lflag |= ECHO;
++		if (ctrl_echo)
++			term.c_lflag |= ECHO;
+ 		if (ctrl_echo && tcsetattr(STDIN_FILENO, TCSANOW, &term) < 0) {
+ 			perror("tcsetattr:error enabling echo");
+ 			return 1;
