[Unit]
Description=beitlab Robotics MilkV duo OS: offline Wi-Fi setup on J22
Wants=beitlab-wpa.service dhcpcd.service rtos-agent.service
After=beitlab-wpa.service dhcpcd.service rtos-agent.service
Before=serial-getty@ttyS0.service
ConditionPathExists=/dev/ttyS0

[Service]
Type=oneshot
ExecStart=/usr/bin/beitlab-wifi-setup --auto
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS0
TTYReset=yes
TTYVHangup=yes
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
