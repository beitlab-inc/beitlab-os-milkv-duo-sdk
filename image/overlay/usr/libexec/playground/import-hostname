#!/bin/sh
# SPDX-License-Identifier: MIT
# Data only: never source or execute files from the FAT boot partition.
set -eu
SRC=/boot/playground/hostname
[ -f "$SRC" ] || exit 0
NAME=$(tr -d '\r' < "$SRC")
if ! printf '%s\n' "$NAME" | awk '
    NR == 1 && length($0) >= 1 && length($0) <= 63 &&
        $0 ~ /^[a-z0-9][a-z0-9-]*$/ && $0 !~ /-$/ { valid=1; next }
    { valid=0; bad=1 }
    END { exit !(valid && !bad) }
'; then
    echo 'beitlab: invalid boot hostname; keeping the current name.' >&2
    exit 1
fi
TEMP=$(mktemp /etc/.beitlab-hostname.XXXXXX)
trap 'rm -f "$TEMP"' EXIT
printf '%s\n' "$NAME" > "$TEMP"
chmod 644 "$TEMP"
chown 0:0 "$TEMP"
mv -f "$TEMP" /etc/hostname
hostname "$NAME"
awk -v name="$NAME" '
    $1 == "127.0.1.1" { $2=name; found=1 }
    { print }
    END { if (!found) print "127.0.1.1 " name }
' /etc/hosts > "$TEMP"
chmod 644 "$TEMP"
chown 0:0 "$TEMP"
mv -f "$TEMP" /etc/hosts
# Keep the serial login banner accurate for the customized mDNS name.
sed -i "s/^Network name: .*/Network name: $NAME.local/" /etc/issue
sync
rm -f "$SRC"
sync
echo "beitlab: hostname configured as $NAME.local"
