#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""beitlab-board-status: read the board inspector's report and write /run/beitlab/board-status.json.

Robotics Board image only (PROMPT.md 0.5.0). The C906 starter on that image is the read-only
board inspector; Linux cannot reach I2C4 itself. This asks for the report over the mailbox with
bl_send (ids in firmware/include/playground_cmd.h) and decodes it here, so the decoding is tested
on the host with recorded values.

Exit: 0 report written; 1 the inspector did not answer (another program runs on the C906, or the
standalone image).
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path

CMD_STATE = 0x10
CMD_FIELD = 0x11
FORMAT = 1
F_FORMAT, F_FOUND, F_IMU_ID, F_ADC0, F_ADC1, F_ADC2, F_ADC3, F_ADC_PGA, F_PCA_MODE1, F_NFAULT = range(10)
FIELDS = 10
FOUND_IMU, FOUND_ADC, FOUND_PCA = 1, 2, 4

# ADS1115 PGA code -> full-scale volts (datasheet table 8; codes 5-7 are all 0.256 V).
PGA_FSR = {0: 6.144, 1: 4.096, 2: 2.048, 3: 1.024, 4: 0.512, 5: 0.256, 6: 0.256, 7: 0.256}
# Divider gains (Rtop + Rbottom) / Rbottom, from Balanced_robot include/balance/board_carrier.h.
GAIN = {"vbat": 11.0, "vservo": 5.7, "v5": 5.7, "vmot": 11.0}
# Rail limits. Battery: 4S LiPo, 3.3-4.2 V/cell, up to 21 V with the rev 0.2 charger plugged in
# (Robotics_board hardware/README.md). +5V is set to 5.32 V and VSERVO is the 6 V buck
# (board_carrier.h); both allow +-5 % / +-8 %.
LIMITS = {"vbat": (13.2, 21.5), "vservo": (5.52, 6.48), "v5": (5.05, 5.59)}
VMOT_OFF_V = 1.0
BMI323_CHIP_ID_LOW = 0x43


def volts(raw: int, pga: int, gain: float) -> float:
    signed = raw - 0x10000 if raw & 0x8000 else raw
    return round(signed * PGA_FSR.get(pga, 4.096) / 32768.0 * gain, 2)


def decode(fields: list[int], when: str) -> dict:
    """Turn the inspector's raw fields into the status panel report."""
    if len(fields) != FIELDS or fields[F_FORMAT] != FORMAT:
        raise ValueError(f"unknown report format {fields[F_FORMAT] if fields else None}")
    found = fields[F_FOUND]
    warnings: list[str] = []
    report: dict = {"format": FORMAT, "time": when}

    imu_ok = bool(found & FOUND_IMU) and (fields[F_IMU_ID] & 0xFF) == BMI323_CHIP_ID_LOW
    report["imu"] = {"ok": imu_ok, "found": bool(found & FOUND_IMU), "chip_id": f"0x{fields[F_IMU_ID]:04x}"}
    if found & FOUND_IMU and not imu_ok:
        warnings.append(f"IMU answered with chip ID 0x{fields[F_IMU_ID]:04x}, expected low byte 0x43")

    if found & FOUND_ADC:
        pga = fields[F_ADC_PGA]
        rails = {name: volts(fields[idx], pga, GAIN[name])
                 for name, idx in (("vbat", F_ADC0), ("vservo", F_ADC1), ("v5", F_ADC2), ("vmot", F_ADC3))}
        rails_ok = True
        for name, (lo, hi) in LIMITS.items():
            if not lo <= rails[name] <= hi:
                rails_ok = False
                warnings.append(f"{name} is {rails[name]:.2f} V, expected {lo:g}-{hi:g} V")
        motor_power = rails["vmot"] >= VMOT_OFF_V
        if motor_power and abs(rails["vmot"] - rails["vbat"]) > 1.5:
            rails_ok = False
            warnings.append(f"vmot {rails['vmot']:.2f} V does not follow the battery ({rails['vbat']:.2f} V)")
        report["rails"] = {"ok": rails_ok, "found": True, **rails}
        report["motor_power"] = ("on" if motor_power else "off (E-stop open or not armed)")
    else:
        report["rails"] = {"ok": False, "found": False}

    report["servo_driver"] = {"ok": bool(found & FOUND_PCA), "found": bool(found & FOUND_PCA),
                              "mode1": f"0x{fields[F_PCA_MODE1]:02x}"}

    fault_low = fields[F_NFAULT] == 0
    report["driver_fault"] = {"ok": not fault_low, "level": "low" if fault_low else "high",
                              "note": "only meaningful while the motor drivers are awake"}
    if found and fault_low:
        warnings.append("motor driver fault input (DRV_NFAULT) is low")

    if not found:
        report["carrier"] = "missing"
        warnings = ["Carrier not found: no board part answered. On a bare Duo S use the standalone image."]
    else:
        report["carrier"] = "found"
        for part, bit, label in (("imu", FOUND_IMU, "IMU (BMI323)"), ("rails", FOUND_ADC, "rail monitor (ADS1115)"),
                                 ("servo_driver", FOUND_PCA, "aux servo driver (PCA9685)")):
            if not found & bit:
                warnings.append(f"{label} did not answer")
    report["warnings"] = warnings
    report["ok"] = report["carrier"] == "found" and not warnings
    return report


def bl_send(cmd: list[str], cmd_id: int, value: int) -> int | None:
    try:
        p = subprocess.run(cmd + [hex(cmd_id), str(value), "1000"], capture_output=True, text=True,
                           timeout=5, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    out = p.stdout.strip()
    return int(out) if p.returncode == 0 and out.isdigit() else None


def read_fields(cmd: list[str], wait_s: float = 3.0) -> list[int] | None:
    deadline = time.monotonic() + wait_s
    while True:
        state = bl_send(cmd, CMD_STATE, 0)
        if state is not None and state & 1:
            break
        if time.monotonic() >= deadline:
            return None
        time.sleep(0.2)
    fields = []
    for index in range(FIELDS):
        value = bl_send(cmd, CMD_FIELD, index)
        if value is None:
            return None
        fields.append(value)
    return fields


def write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, indent=1) + "\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def main() -> int:
    cmd = os.environ.get("BEITLAB_BL_SEND", "/usr/bin/bl_send").split()
    out = Path(os.environ.get("BEITLAB_BOARD_STATUS", "/run/beitlab/board-status.json"))
    fields = read_fields(cmd)
    if fields is None:
        print("beitlab-board-status: the board inspector did not answer", file=sys.stderr)
        return 1
    try:
        report = decode(fields, time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
    except ValueError as exc:
        print(f"beitlab-board-status: {exc}", file=sys.stderr)
        return 1
    write_json(out, report)
    print(f"carrier {report['carrier']}; " + ("all checks passed" if report["ok"] else "; ".join(report["warnings"])))
    return 0


if __name__ == "__main__":
    sys.exit(main())
